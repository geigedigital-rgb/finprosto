# Public site URL (no trailing slash). Used for WayForPay return/callback and SEO.
SITE_URL=https://finprosto.com
VITE_SITE_URL=https://finprosto.com

# WayForPay
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_ACCOUNT=finprosto_com
WAYFORPAY_MERCHANT_DOMAIN=finprosto.com
VITE_WAYFORPAY_MERCHANT_ACCOUNT=finprosto_com
VITE_WAYFORPAY_MERCHANT_DOMAIN=finprosto.com

# SendPulse Events Manager (Automation360) — preferred after payment
# Copy "POST URL" from event card (no auth needed)
SENDPULSE_EVENT_URL=https://events.sendpulse.com/events/id/EVENT_ID/USER_ID
# Optional REST fallback (by event name + OAuth)
SENDPULSE_EVENT_NAME=abandoned_shopping_cart
SENDPULSE_API_ID=
SENDPULSE_SECRET=
# SENDPULSE_BOOK_ID — only for old address-book API; not needed for Events Manager

# Telegram (contact forms)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server port (Railway sets PORT automatically)
PORT=3001
